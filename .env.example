# Optional. With a token Megneto renders Cesium World Terrain + Bing aerial imagery.
# Without one it silently falls back to OpenStreetMap raster tiles + an ellipsoid
# globe, which still looks good and needs no account. Get one free at
# https://ion.cesium.com/tokens
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Facility pin. Defaults to a residential plot in Bengaluru.
NEXT_PUBLIC_FACILITY_LAT=12.9352
NEXT_PUBLIC_FACILITY_LON=77.6245
